PT_LOAD                 = 1

SHT_PROGBITS            = 1
SHT_SYMTAB              = 2
SHT_STRTAB              = 3
SHT_DYNSYM              = 11

STB_LOCAL               = 0
STB_GLOBAL              = 1
STB_WEAK                = 2

def ST_BIND(info): return info>>4
def ST_TYPE(info): return info&0xf
def ST_INFO(bind, type_): return (bind<<4) + (type_&0xf)

# dereference name (must be done after all SH load)
def Elf_Name(self, sh):
	i = self.name
	n = sh.data.find(B"\0", i)
	self.name = sh.data[i:n].decode()

class Elf32_Ehdr:
	def __init__(self, data):
		self.ident, self.type, self.machine, self.version, self.entry, \
			self.phoff, self.shoff, self.flags, self.ehsize, self.phentsize, \
			self.phnum, self.shentsize, self.shnum, self.shstrndx = \
			struct.unpack(">16sHHIIIIIHHHHHH", data)
		self.ident = struct.unpack(">16B", self.ident)

class Elf32_Phdr:
	def __init__(self, data):
		self.type, self.offset, self.vaddr, self.paddr, self.filesz, \
			self.memsz, self.flags, self.align = \
			struct.unpack(">IIIIIIII", data)

class Elf32_Shdr:
	def __init__(self, data):
		self.name, self.type, self.flags, self.addr, self.offset, self.size, \
			self.link, self.info, self.addralign, self.entsize = \
			struct.unpack(">IIIIIIIIII", data)
	def load(self, f):
		f.seek(self.offset)
		if self.type == SHT_SYMTAB or self.type == SHT_DYNSYM:
			self.num = self.size//16
			self.data = [Elf32_Sym(f.read(16)) for i in range(self.num)]
		else:
			self.data = f.read(self.size)
	def get(self, addr, fmt):
		x, = struct.unpack_from(">"+fmt, self.data, addr-self.addr)
		return x

class Elf32_Sym:
	def __init__(self, data):
		self.name, self.value, self.size, self.info, self.other, self.shndx = \
			struct.unpack(">IIIBBH", data)

class Elf32:
	def __init__(self, path):
		with open(path, "rb") as f:
			self.eh = Elf32_Ehdr(f.read(52))
			f.seek(self.eh.phoff)
			self.ph = [Elf32_Phdr(f.read(32)) for i in range(self.eh.phnum)]
			f.seek(self.eh.shoff)
			self.sh = [Elf32_Shdr(f.read(40)) for i in range(self.eh.shnum)]
			for sh in self.sh: sh.load(f)
			for sh in self.sh: Elf_Name(sh, self.sh[self.eh.shstrndx])
			self.section = {sh.name: sh for sh in self.sh}
			for sym in self.section[".dynsym"].data:
				Elf_Name(sym, self.section[".dynstr"])
			sh = self.section[".text"]
			self.ftext = sh.addr
			self.etext = sh.addr + sh.size
			self.fdata = 1 << 32
			self.edata = -1
			for name in (".data",".rodata",".got"):
				if name in self.section:
					sh = self.section[name]
					self.fdata = min(self.fdata, sh.addr)
					self.edata = max(self.edata, sh.addr+sh.size)
	def get(self, addr, fmt):
		for sh in self.sh:
			if addr >= sh.addr and addr < sh.addr+sh.size:
				return sh.get(addr, fmt)
		return None
	def lw(self, addr):
		assert (addr & 3) == 0, "%X" % addr
		return self.get(addr, "i")
	def lwu(self, addr):
		assert (addr & 3) == 0, "%X" % addr
		return self.get(addr, "I")


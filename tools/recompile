	def FCMP(self, fs, ft):
		c, op, fmt = self.op.split(".")
		op = {
			"eq": "==",
			"lt": "<",
			"le": "<=",
		}[op]
		self.set("c1c", makeop(self.get(fs), op, self.get(ft)))
	def LOAD(self, rt, rs, imm):
		f = {
			"lb": "*cpu_s8",
			"lh": "*cpu_s16",
			"lw": "*cpu_s32",
			"lbu": "*cpu_u8",
			"lhu": "*cpu_u16",
			"ulw": "__ulw",
			"lwc1": "*cpu_s32",
		}[self.op]
		addr = makeop(self.get(rs), "+", imm)
		if isinstance(addr, int) and (
			addr >= self.elf.section[".rodata"].addr and
			addr < self.elf.edata
		):
			val = {
				"lw": self.elf.lw,
				"lwc1": self.elf.lw,
			}[self.op](addr)
		else:
			val = makeop(f, "(", addr)
		self.set(rt, val)
	def STORE(self, rt, rs, imm):
		addr = makeop(self.get(rs), "+", imm)
		f = {
			"sb": "*cpu_s8",
			"sh": "*cpu_s16",
			"sw": "*cpu_s32",
			"usw": "__usw",
			"swc1": "*cpu_s32",
		}[self.op]
		if f.startswith("*"):
			self.out.append(makeop(makeop(f, "(", addr), "=", self.get(rt)))
		else:
			self.out.append(makeop(f, "(", (addr, self.get(rt))))


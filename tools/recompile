#!/usr/bin/env python3

import sys
import struct

# print() to stderr
def debug(*args, sep=' ', end='\n'):
	sys.stderr.write(sep.join([str(arg) for arg in args])+end)

# cast to unsigned type
def mask(x, n):
	return x & ((1 << n)-1)

# cast to signed type
def sign(x, n):
	bit = 1 << n
	return (x & (bit-1)) - (x << 1 & bit)


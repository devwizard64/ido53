	def getio(self, io):
		return set([reg.partition(".")[0] for reg in (
			self.arg[i] if isinstance(i, int) else i
			for i in self.iotab[self.op][io]
		) if isinstance(reg, str)])
	def getwr(self):
		return self.getio(0)
	def getrd(self):
		return self.getio(1)

	# allocation
	def alloc(self, proc):
		self.proc = proc
		self.proc.reg |= self.getrd()

	# compiling
	def get(self, reg):
		if isinstance(reg, str):
			r = reg.partition(".")[0]
			if r in glbreg: reg = "cpu->" + reg
			# if reg in self.proc.val: return self.proc.val[reg]
		return reg
	def set(self, reg, val):
		if reg == symtab["_gp_disp"]: return
		assert isinstance(reg, str)
		r = reg.partition(".")[0]
		if r in self.proc.reg:
			if r in glbreg: reg = "cpu->" + reg
			if isinstance(val, int):    self.proc.val[reg] = val
			elif reg in self.proc.val:  self.proc.val.pop(reg)
			self.out.append(makeop(reg, "=", val))
	def branch(self, cond, target):
		if cond:
			self.cond = cond
			self.proc.btbl.add(target)
			self.out.append("goto _%X" % target)
			if "noslot" not in self.flag: self.slot = None

	def get64(self, i, t):
		hi = cast(self.get(gpr[i+0]), t)
		lo = cast(self.get(gpr[i+1]), "uint32_t")
		return makeop(makeop(hi, "<<", 32), "|", lo)
	def set64(self, v):
		self.proc.reg.add("ll")
		self.set("ll", v)
		v = self.get("ll")
		self.set("v0", makeop(v, ">>", 32))
		self.set("v1", v)
	def ll_op(self, op, l, r):
		self.set64(makeop(self.get64(4, l), op, self.get64(6, r)))
	def ll_shift(self, op, t):
		r = makeop(self.get("a3"), "&", 63)
		self.set64(makeop(self.get64(4, t), op, r))

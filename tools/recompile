	"f20","f22","f24","f26","f28","f30"
}

class Inst:
	# disassembly
	def RS(self, inst): return gpr[inst["rs"]]
	def RT(self, inst): return gpr[inst["rt"]]
	def RD(self, inst): return gpr[inst["rd"]]
	def FTs(self, inst): return "f%d.f[IX]" % inst["rt"]
	def FSs(self, inst): return "f%d.f[IX]" % inst["rd"]
	def FDs(self, inst): return "f%d.f[IX]" % inst["sa"]
	def FTd(self, inst): return "f%d.d" % inst["rt"]
	def FSd(self, inst): return "f%d.d" % inst["rd"]
	def FDd(self, inst): return "f%d.d" % inst["sa"]
	def FSw(self, inst): return "f%d.i[IX]" % inst["rd"]
	def FDw(self, inst): return "f%d.i[IX]" % inst["sa"]
	def FTW(self, inst):
		return "f%d.i[%d^IX]" % (inst["rt"] & ~1, inst["rt"] & 1)
	def FSW(self, inst):
		return "f%d.i[%d^IX]" % (inst["rd"] & ~1, inst["rd"] & 1)
	def IMM(self, inst): return inst["inst"] & 0xFFFF
	def IMMS(self, inst): return sign(inst["inst"], 16)
	def BDST(self, inst):
		self.flag.add("branch")
		return self.addr+4 + (sign(inst["inst"], 16) << 2)
	def JDST(self, inst):
		return (self.addr & 0xF0000000) | (inst["inst"] & 0x3FFFFFF) << 2
	optab = {
		0x00: ({
			0x00: ("sll", RD, RT, "sa"),
			0x02: ("srl", RD, RT, "sa"),
			0x03: ("sra", RD, RT, "sa"),
			0x04: ("sll", RD, RT, RS),
			0x06: ("srl", RD, RT, RS),
			0x07: ("sra", RD, RT, RS),
			0x08: ("j", RS),
			0x09: ("jal", RS),
			0x0D: ("break", "rt"),
			0x10: ("mfhi", RD),
			0x12: ("mflo", RD),
			0x19: ("multu", RS, RT),
			0x1A: ("div", RS, RT),
			0x1B: ("divu", RS, RT),
			0x21: ("addu", RD, RS, RT),
			0x22: ("sub", RD, RS, RT),
			0x23: ("subu", RD, RS, RT),
			0x24: ("and", RD, RS, RT),
			0x25: ("or", RD, RS, RT),

	def FOP(self, fd, fs, ft):
		op, fmt = self.op.split(".")
		op = {
			"add": "+",
			"sub": "-",
			"mul": "*",
			"div": "/",
		}[op]
		self.set(fd, makeop(self.get(fs), op, self.get(ft)))
	def FMOV(self, fd, fs):

	def compile(self):
		self.out = []
		self.cond = 1
		return self.comptab[self.op](self, *self.arg)

	def output_block(self, block, tab="\t"):
		for op in block:
			if isinstance(op, int): print("_%X:" % op)
			else: print("%s%s;" % (tab, op))
	def output_inst(self, block, cond=None):
		block = [
			op for op in block
			if not isinstance(op, int) or op in self.proc.btbl
		]
		if cond:
			if len(block) == 1 and not isinstance(block[0], int):
				print("\t%s %s;" % (cond, block[0]))
			else:
				print("\t%s\n\t{" % cond)
				self.output_block(block, "\t\t")
				print("\t}")
		else:
			self.output_block(block)
	def output(self):
		self.output_inst([self.addr])
		# print("\t/* %.X:%s */" % (self.addr, self)) # DEBUG
		if hasattr(self, "slot"):
			# print("\t/* %.X:%s */" % (self.slot.addr, self.slot)) # DEBUG
			if self.slot.getwr() & self.getrd() or (
				self.slot.addr in self.proc.btbl
			):
				# must execute in order
				if self.cond != 1:
					cond_if = "if (%s)" % self.cond
					cond_else = "else"
				else:
					cond_if = cond_else = None
				self.output_inst(self.slot.out + self.out, cond_if)
				self.output_inst([self.slot.addr] + self.slot.out, cond_else)
				return
			else:
				# can execute out of order
				self.output_inst(self.slot.out)
		self.output_inst(
			self.out, "if (%s)" % self.cond if self.cond != 1 else None
		)

################################################################################
# Proc
################################################################################

class Proc:
	def __init__(self, asm, addr, inst, jtbl):
		self.asm = asm
		self.addr = addr
		self.inst = inst
		self.jtbl = jtbl
		self.btbl = set([x for i in jtbl for x in jtbl[i]])
		self.reg = glbreg.copy() # reg usage
		self.val = {} # reg value
		self.out = [] # inst in output order
		# lui gp,xxx
		# addu gp,gp,xxx
		# addu gp,gp,t9 [proc entry]
		if (
			inst[0].eq("lui", gpr[28], None) and
			inst[1].eq("addu", gpr[28], gpr[28], None) and
			inst[2].eq("addu", gpr[28], gpr[28], "t9") and
			(inst[0].arg[1]<<16) + inst[1].arg[2] + addr == symtab["_gp_disp"]
		):
			inst[0].kill()
			inst[1].kill()
			inst[2].kill()

	def compile(self):
		for inst in self.inst: inst.alloc(self)
		delay = None
		for inst in self.inst:
			if inst.addr in self.btbl: self.val.clear()
			inst.compile()
			if delay:
				delay.slot = inst
				delay = None
			else:
				if hasattr(inst, "slot"): delay = inst
				self.out.append(inst)
		assert delay is None, delay

	def output_reg(self, reg, t, v=""):
		r = [i+v for i in reg if i in self.reg]
		if r: print("\t%s %s;" % (t, ", ".join(r)))
	def output(self):
		print("\nstatic void %s(CPU *cpu)\n{" % addrtab[self.addr])
		for i in sorted(self.jtbl.keys()):
			print((
				"\tstatic void *const jtbl%X[] =\n"
				"\t{"
			) % i)
			for i in self.jtbl[i]: print("\t\t&&_%X," % i)
			print("\t};")
		self.reg -= glbreg
		self.output_reg((
			"at","v0","v1","a0","a1","a2","a3",
			"t0","t1","t2","t3","t4","t5","t6","t7",
			"s0","s1","s2","s3","s4","s5","s6","s7",
			"t8","t9","gp","sp","fp","ra","hi","lo",
		), "int32_t", "=0")
		self.output_reg((
			"f0","f2","f4","f6","f8","f10","f12","f14",
			"f16","f18","f20","f22","f24","f26","f28","f30",
		), "REG", "={0}")
		self.output_reg(("c1c",), "int", "=0")
		self.output_reg(("ll",), "int64_t")
		if "gp" in self.reg: print("\tgp = 0x%X;" % symtab["_gp_disp"])
		for inst in self.out: inst.output()
		print("}")

################################################################################
# Asm
################################################################################

class Asm:
	def __init__(self, elf):
		self.elf = elf
		self.inst = [
			Inst(self.elf, addr, self.elf.lwu(addr))
			for addr in range(self.elf.ftext, self.elf.etext, 4)
		]
		self.proc = []
	def get(self, addr):
		return self.inst[(addr-self.elf.ftext)//4]
	def set(self, addr, inst):
		self.inst[(addr-self.elf.ftext)//4] = inst

	# patching
	def patch(self, name, callback):
		if name in symtab:
			addr = symtab[name]
			for x in callback():
				self.set(addr, Inst(self.elf, addr, x))
				addr += 4

	# analysis
	def analyze_j(self, inst, jtbl, i):
		rs, = inst.arg
		count = None
		if self.inst[i].eq("addu", rs, rs, gpr[28]):
			self.inst[i].kill("jtbl"); i -= 1
		if self.inst[i].op == "nop": i -= 1
		if self.inst[i].op != "lw": i -= 1
		assert self.inst[i].eq("lw", rs, "at", None), self.inst[i]
		inst.jtbl = self.inst[i].arg[2]
		self.inst[i].kill("jtbl"); i -= 1
		if self.inst[i].op != "addu": i -= 1
		assert self.inst[i].eq("addu", "at", "at", rs), self.inst[i]
		self.inst[i].kill("jtbl"); i -= 1
		assert self.inst[i].eq("sll", rs, None, 2), self.inst[i]
		rt = self.inst[i].arg[1]
		inst.arg = (rt,)
		self.inst[i].kill("jtbl"); i -= 1
		if self.inst[i].eq("and", rt, None, None):
			count = self.inst[i].arg[2] + 1
			i -= 1
		if self.inst[i].eq("lw", "at", gpr[28], None):
			inst.jtbl += self.elf.lwu(symtab["_gp_disp"]+self.inst[i].arg[2])
		elif self.inst[i].eq("lui", "at", None):
			inst.jtbl += self.inst[i].arg[1] << 16
		else:
			raise RuntimeError("bad jr (li) %s" % self.inst[i])
		self.inst[i].kill("jtbl"); i -= 1
		if count is None:
			rt = {rt}
			for _ in range(12):
				if self.inst[i].eq("or", rt, None, 0):
					rt.add(self.inst[i].arg[1])
				if self.inst[i].eq("sltu", "at", rt, None):
					count = self.inst[i].arg[2]
					break
				if self.inst[i].op in {"ret","j"}:
					raise RuntimeError("bad jr (sltiu)")
				i -= 1
			else:
				raise RuntimeError("bad jr (sltiu over)")
		jtbl[inst.jtbl] = [
			symtab["_gp_disp"] + self.elf.lw(inst.jtbl+4*i)
			for i in range(count)
		]
	def analyze_jal(self, inst, start, i):
		phase = 0
		rel = None
		offset = 0
		while i > start:
			i -= 1
			x = self.inst[i]
			if "t9" in x.getwr():
				if x.op == "lw":
					rt, rs, imm = x.arg
					if rs == gpr[28]:
						if phase == 0:
							# lw t9,gp,xxx
							# [addu t9,t9,xxx]
							inst.arg = (
								self.elf.lw(symtab["_gp_disp"]+imm)+offset,
							)
							return
					if rs != "t9": return
					if phase == 0:
						# lw t9,gp,xxx
						# lui t9,xxx
						# addiu t9,t9,gp
						# lw t9,t9,xxx
						rel = imm
						phase = 1
						continue
				elif x.op == "addu":
					rd, rs, rt = x.arg
					if rs != "t9": return
					if phase == 0:
						assert offset == 0
						offset = rt
						continue
					elif phase == 1:
						assert rt == gpr[28]
						phase = 2
						continue
				elif x.op == "lui":
					rt, imm = x.arg
					if phase == 2:
						rel += imm << 16
						inst.arg = (self.elf.lw(symtab["_gp_disp"]+rel)+offset,)
						return
				raise RuntimeError("jal 0x%X:%s phase=%d" % (x.addr, x, phase))
		raise RuntimeError(inst)
	def analyze_uls(self, inst, i):
		op = inst.op[:-1]
		rt, rs, imm = inst.arg
		if inst.op[-1] == "l": # lwl/swl
			comp = op+"r" # complement
			base = imm
			imm += 3
		else: # lwr/swr
			comp = op+"l" # complement
			imm -= 3
			base = imm
		end = len(self.inst)
		while i < end:
			x = self.inst[i]
			i += 1
			if "branch" in x.flag: end = i+1
			elif x.eq(comp, rt, rs, imm):
				inst.kill()
				x.kill()
				x.op = "u"+op
				x.arg = (rt, rs, base)
				return
	def analyze(self):
		i = 0
		while i < len(self.inst):
			while i < len(self.inst):
				if self.inst[i].op != "nop": break
				i += 1
			if i >= len(self.inst): break
			# begin proc
			addr = self.inst[i].addr
			start = i
			jtbl = {}
			maxb = addr
			reg = set()
			kill = {}
			sp = {"sp"}
			while i < len(self.inst):
				inst = self.inst[i]
				if inst.op == "ret":
					if inst.addr >= maxb: # final ret
						i += 2
						break
				elif inst.op == "j": # jtbl extraction
					self.analyze_j(inst, jtbl, i-1)
				elif inst.op == "jal":
					if inst.arg[0] == "t9":
						self.analyze_jal(inst, start, i)
				elif "branch" in inst.flag:
					target = inst.arg[-1]
					if maxb < target: maxb = target
					if target == inst.addr+8: # pointless branch
						inst.kill("pointless")
					else:
						slot = self.inst[i+1]
						if slot.op == "nop": # need not consider slot
							inst.flag.add("noslot")
						else:
							# if slot inst matches inst before target,
							# adjust target and mark noslot
							target = inst.arg[-1] - 4
							if slot == self.get(target):
								inst.arg = inst.arg[:-1] + (target,)
								inst.flag.add("noslot")
				elif inst.op in {"lwl","lwr","swl","swr"}: # ulw/usw subst.
					self.analyze_uls(inst, i+1)
				# kill save reg backup/restore inst.
				elif inst.op == "or": # fp usage
					if inst.arg == ("fp","sp",0): sp.add("fp")
				elif inst.op in {"sw","swc1"}:
					rt, rs, imm = inst.arg
					if rs in sp and isinstance(rt, str) and rt not in kill:
						r = rt.partition(".")[0]
						if r in savereg and r not in reg:
							kill[rt] = imm
							inst.kill("save reg")
				elif inst.op in {"lw","lwc1"}:
					rt, rs, imm = inst.arg
					if rs in sp and rt in kill and imm == kill[rt]:
						kill.pop(rt)
						inst.kill("save reg")
				reg |= inst.getwr()
				i += 1
			# end proc
			if "_mcount" in symtab and addr <= symtab["_mcount"]: continue
			if addr not in addrtab: addrtab[addr] = "app_%X" % addr
			assert not kill, addrtab[addr]
			self.proc.append(Proc(self, addr, self.inst[start:i], jtbl))

################################################################################
# loading

symtab = {} # (pre-)name to addr translation
addrtab = {} # address to (post-)name translation
undtab = {"__ctype", "errno", "_bufendtab", "__iob"} # symbol import
proc_flag = False # program requires __getproc

# process symtab from executable
def loadsym(elf):
	for sym in elf.section[".dynsym"].data[1:]:
		name = sym.name
		addr = sym.value
		# library symbol
		if sym.shndx == 0x0000 or sym.shndx == 0xFFF2: # UND / COM
			if not name.startswith("."):
				undtab.add(name)
				# defined in executable before processed assembly
				if name == "_rld_new_interface": addrtab[addr] = "lib_" + name
		# executable symbol
		else:
			if name not in symtab: symtab[name] = addr
			if addr not in addrtab: addrtab[addr] = "app_" + name

def loadext(elf):
	for sym in elf.section[".dynsym"].data[1:]:
		name = sym.name
		addr = sym.value
		if name in undtab: # collect undefined symbol address
			if name not in symtab: symtab[name] = addr
			# prefer function not prefixed with _
			if addr not in addrtab or not name.startswith("_"):
				# do not include data symbols
				if name not in {
					"__elf_header",
					"__program_header_table",
					"sys_errlist",
					"sys_nerr",
					"__ctype",
					"__us_rsthread_stdio",
					"errno",
					"_environ",
					"_bufendtab",
					"__iob",
					"_smbuf",
					"_sibuf",
					"_sobuf",
				}: addrtab[addr] = "lib_" + name

################################################################################
# patching

def HI(x): return (x >> 16) + (x >> 15 & 1)
def LO(x): return x & 0xFFFF

def NOP():            return 0
def RET():            return 0x03E00008
def JAL(addr):        return  3 << 26 | (addr & 0xFFFFFFC) >> 2
def LA_U(rt, addr):   return 15 << 26 |            rt << 16 | HI(addr)
def LA_L(rt, addr):   return  9 << 26 | rt << 21 | rt << 16 | LO(addr)

# assembly uses a branch into alloc_new
def xmalloc():
	yield LA_U(5, symtab["malloc_scb"])
	yield JAL(symtab["alloc_new"])
	yield LA_L(5, symtab["malloc_scb"])
	yield RET()
	yield NOP()
	yield NOP()
	yield NOP()

# assembly uses a branch into alloc_dispose
def xfree():
	yield LA_U(5, symtab["malloc_scb"])
	yield JAL(symtab["alloc_dispose"])
	yield LA_L(5, symtab["malloc_scb"])
	yield RET()
	yield NOP()

# assembly uses lwr without matching lwl; prefer memcpy
def memmove():
	yield JAL(symtab["memcpy"])
	yield NOP()
	yield RET()
	yield NOP()
	addr = symtab["memmove"] + 4*4
	while addr not in addrtab:
		yield NOP()
		addr += 4

################################################################################

def main(argv):
	if len(argv) < 2:
		sys.stderr.write("usage: %s [-s] <elf> [ext ...]" % argv[0])
		return 1

	elf = None
	for arg in argv[1:]:
		if arg.startswith("-"):
			if arg == "-s":
				# global s2 (ugen hack)
				glbreg.add("s2")
				savereg.discard("s2")
			else:
				raise RuntimeError("unknown option %s" % arg)
		elif not elf:
			# load executable
			elf = Elf32(arg)
			loadsym(elf)
		else:
			# load shared library symbols
			loadext(Elf32(arg))

	gpr[28] = symtab["_gp_disp"]

	# disassemble
	asm = Asm(elf)
	# patch
	asm.patch("xmalloc", xmalloc)
	asm.patch("xfree", xfree)
	asm.patch("memmove", memmove)
	# split into proc and do asm-level transformation
	asm.analyze()

	# compilation
	for proc in asm.proc: proc.compile()

	# program output
	print("#include \"app.h\"\n")
	print("PTR *const _bufendtab = cpu_ptr(0x%X);" % symtab["_bufendtab"])
	print("IRIX_FILE *const __iob = cpu_ptr(0x%X);" % symtab["__iob"])
	print("")
	for proc in asm.proc:
		print("static void %s(CPU *cpu);" % addrtab[proc.addr])
	print("")
	if proc_flag: # generate __getproc
		print(
			"typedef struct\n{\n"
			"\tPTR addr;\n"
			"\tCPUPROC proc;\n"
			"}\nProcEntry;\n\n"
			"static const ProcEntry proctab[] =\n{"
		)
		for proc in asm.proc:
			print("\t{0x%X, %s}," % (proc.addr, addrtab[proc.addr]))
		print((
			"\t{-1, NULL},\n"
			"};\n\n"
			"CPUPROC __getproc(PTR addr)\n"
			"{\n"
			"\tconst ProcEntry *entry = proctab;\n"
			"\tunsigned int len = %d;\n"
			"\tdo\n"
			"\t{\n"
			"\t\tif (len > 1) len /= 2;\n"
			"\t\tif (addr >= entry[len].addr) entry += len;\n"
			"\t\telse if (len == 1) fatal(\"no proc for 0x%%X\\n\", addr);\n"
			"\t}\n"
			"\twhile (addr != entry->addr && addr != entry->addr+12);\n"
			"\treturn entry->proc;\n"
			"}\n"
		) % len(asm.proc))
	print((
		"static const uint32_t data[] =\n"
		"{"
	))
	for addr in range(elf.fdata, elf.edata, 16):
		print("\t" + "".join([
			"0x%.8X," % elf.lwu(addr) for addr in range(addr, addr+16, 4)
		]))
	print(
		"};\n\n"
		"int main(int argc, char *argv[])\n"
		"{\n"
		"\tCPU cpu;\n"
		"\tmemset(&cpu, 0, sizeof(CPU));\n"
		"\texecpath = argv[0];"
	)
	print("\tlib_brk(0x%X);" % symtab["_end"])
	print("\tint_writemem(0x%X, __ctype, 257);" % symtab["__ctype"])
	print(
		"\t__iob[0]._file = 0; __iob[0]._flag = IOFBF|IOREAD;\n"
		"\t__iob[1]._file = 1; __iob[1]._flag = IOLBF|IOWRT;\n"
		"\t__iob[2]._file = 2; __iob[2]._flag = IOLBF|IOWRT;\n"
		"\tatexit(lib__cleanup);"
	)
	print("\tmemcpy(cpu_ptr(0x%X), data, sizeof(data));" % elf.fdata)
	print("\tcpu.sp = 0x%X;" % (elf.fdata-16))
	print("\tcpu.a0 = *cpu_s32(0x%X) = argc;" % symtab["__Argc"])
	print("\tcpu.a1 = *cpu_s32(0x%X) = int_writearg(argv);" % symtab["__Argv"])
	print(
		"\tapp_main(&cpu);\n"
		"\treturn cpu.v0;\n"
		"}"
	)
	for proc in asm.proc: proc.output()
	return 0

if __name__ == "__main__": sys.exit(main(sys.argv))

			0x27: ("nor", RD, RS, RT),
			0x2A: ("slt", RD, RS, RT),
			0x2B: ("sltu", RD, RS, RT),
		}, "func"),
		0x01: ({
			0x00: ("blt", RS, 0, BDST),
			0x01: ("bge", RS, 0, BDST),
			0x11: ({
				0: ("bal", BDST),
			}, "rs")
		}, "rt"),
		0x03: ("jal", JDST),
		0x04: ("beq", RS, RT, BDST),
		0x05: ("bne", RS, RT, BDST),
		0x06: ("ble", RS, 0, BDST),
		0x07: ("bgt", RS, 0, BDST),
		0x08: ("add", RT, RS, IMMS),
		0x09: ("addu", RT, RS, IMMS),
		0x0A: ("slt", RT, RS, IMMS),
		0x0B: ("sltu", RT, RS, IMMS),
		0x0C: ("and", RT, RS, IMM),
		0x0D: ("or", RT, RS, IMM),
		0x0E: ("xor", RT, RS, IMM),
		0x0F: ("lui", RT, IMM),
		0x11: ({

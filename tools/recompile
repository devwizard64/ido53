	def call(self, name):
		global proc_flag
		defname = name[4:]
		if defname in self.inline:
			self.inline[defname](self)
			return
		if defname not in self.lib:
			self.out.append("notimpl(\"%s\")" % defname)
			return
		info = self.lib[defname]
		if info is None: return
		info = info.split(":")
		if len(info) > 2: name = info[2] if info[2] else defname
		i = 0
		arg = []
		for a in info[0][1:]:
			if a == "&":
				arg.append("cpu")
			elif a == "*":
				arg.append(makeop(self.get("sp"), "+", 4*i))
				for i in range(i, 4): self.out.append(makeop(makeop(
					"*cpu_s32", "(", makeop(self.get("sp"), "+", 4*i)
				), "=", self.get("a%d" % i)))
			elif a == "d":
				assert i < 4
				i = (i+1) & ~1
				arg.append(self.get("f%d.d" % (12+i)))
				i += 2
			else:
				if i < 4:
					v = self.get("a%d" % i)
					if a == "u": v = cast(v, "uint32_t")
				else:
					v = makeop(
						"*cpu_u32" if a in "uPNQ" else "*cpu_s32", "(",
						makeop(self.get("sp"), "+", 4*i)
					)
				if a in "iup": arg.append(v)
				elif a == "P": arg.append(makeop("cpu_ptr", "(", v))
				elif a == "N":
					arg.append("%s ? cpu_ptr(%s) : NULL" % (v, v))
				elif a == "Q":
					if v in self.proc.val:
						arg.append(addrtab[self.proc.val[v]])
					else:
						arg.append(makeop("__getproc", "(", v))
						proc_flag = True
				else:
					raise RuntimeError("invalid arg %s" % a)
				i += 1
		op = makeop(name, "(", tuple(arg))
		v = info[0][0]
		if v == "v": self.out.append(op)
		elif v in "ipu": self.set("v0", op)
		elif v == "l": self.set64(op)
		elif v == "d": self.set("f0.d", op)
		else: raise RuntimeError("invalid return %s" % v)
		if len(info) > 1:
			if "e" in info[1]: self.out.append(makeop(
				makeop("*cpu_s32", "(", symtab["errno"]), "=", "errno"
			))
			if "p" in info[1]: proc_flag = True

	def NOP(self):
		return
	def OP(self, rd, rs, rt):
		op = {
			"sll": "<<",
			"srl": ">>",
			"sra": ">>",
			"add": "+",
			"addu": "+",
			"sub": "-",
			"subu": "-",
			"and": "&",
			"or": "|",
			"xor": "^",
			"nor": "|",
			"slt": "<",
			"sltu": "<",
		}[self.op]
		rs = self.get(rs)
		rt = self.get(rt)
		if self.op in {"sll", "srl", "sra"}:
			if self.op == "srl": rs = cast(rs, "uint32_t")
			rt = makeop(rt, "&", 31)
		elif self.op == "sltu":
			rs = cast(rs, "uint32_t")
			rt = cast(rt, "uint32_t")
		v = makeop(rs, op, rt)
		if self.op == "nor": v = makeop(v, "~")
		if self.op == "sltu" and rt == 0: v = 0
		self.set(rd, v)
	def RET(self):
		self.slot = None
		self.out.append("return")
	def J(self, target):
		assert hasattr(self, "jtbl"), self
		self.slot = None
		self.out.append("goto *jtbl%X[%s]" % (self.jtbl, self.get(target)))
	def JAL(self, target):
		global proc_flag
		self.slot = None
		target = self.get(target)
		if isinstance(target, int):
			for addr in (target, target-12):
				if addr in addrtab: break
			else:
				raise RuntimeError("missing %X (%X)" % (target, self.addr))
			name = addrtab[addr]
			if name.startswith("lib_"):
				self.call(name)
				return
		else:
			name = makeop("__getproc", "(", target)
			proc_flag = True
		self.out.append(makeop(name, "(", "cpu"))
	def BREAK(self, code):
		self.out.append(makeop("__break", "(", ("cpu", code)))
	def MFHI(self, rd):
		self.set(rd, self.get("hi"))
	def MFLO(self, rd):
		self.set(rd, self.get("lo"))
	def MULT(self, rs, rt):
		self.set("lo", makeop(self.get(rs), "*", self.get(rt)))
	def DIV(self, rs, rt):
		rs = self.get(rs)
		rt = self.get(rt)
		if self.op == "divu":
			rs = cast(rs, "uint32_t")
			rt = cast(rt, "uint32_t")
		self.set("lo", makeop(rs, "/", rt))
		self.set("hi", makeop(rs, "%", rt))
	def BRANCH(self, rs, rt, target):
		op = {
			"blt": "<",
			"bge": ">=",
			"beq": "==",
			"bne": "!=",
			"ble": "<=",
			"bgt": ">",
		}[self.op]
		rs = self.get(rs)
		rt = self.get(rt)
		if rs == rt:
			if op == "!=" or "=" not in op: return
			op = 1
		else:
			op = makeop(rs, op, rt)
		self.branch(op, target)
	def BC1F(self, target):
		self.branch(invert(self.get("c1c")), target)
	def BC1T(self, target):
		self.branch(self.get("c1c"), target)
	def LUI(self, rt, imm):
		self.set(rt, imm << 16)
	def MFC1(self, rt, fs):

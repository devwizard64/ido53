		0x31: ("lwc1", FTW, RS, IMMS),
		0x39: ("swc1", FTW, RS, IMMS),
	}
	def __init__(self, elf, addr, inst):
		self.elf = elf
		self.addr = addr
		self.flag = set()
		if inst == 0:
			self.op = "nop"
			self.arg = ()
		elif inst == 0x03E00008:
			self.op = "ret"
			self.arg = ()
		else:
			inst = {
				"inst": inst,
				"op": inst >> 26,
				"rs": inst >> 21 & 31,
				"rt": inst >> 16 & 31,
				"rd": inst >> 11 & 31,
				"sa": inst >>  6 & 31,
				"func": inst & 63,
			}
			trace = []
			info = (self.optab, "op")
			while not isinstance(info[0], str):
				table, index = info
				i = inst[index]
				trace.append("%s=0x%.2X" % (index, i))
				if i not in table: raise RuntimeError("null 0x%X %s" % (
					self.addr, " ".join(trace)
				))
				info = table[i]
			self.op = info[0]
			self.arg = tuple([
				x(self, inst) if callable(x) else
					inst[x] if isinstance(x, str) else x
				for x in info[1:]
			])
		self.comment = ""
	def __str__(self):
		inst = self.op
		if self.arg:
			arg = list(self.arg)
			if "branch" in self.flag:
				arg[-1] = "_%X" % self.arg[-1]
			inst += " " + ",".join([str(x) for x in arg])
		if self.comment: inst += " # " + self.comment
		return inst
	def __repr__(self):
		return "Inst(0x%X: %s)" % (self.addr, self)
	def __eq__(self, value):
		return self.op == value.op and self.arg == value.arg
	def eq(self, op, *args):
		if self.op != op: return False
		for a, b in zip(self.arg, args):
			if b is None: continue
			if isinstance(b, set):
				if a not in b: return False
			else:
				if a != b: return False
		return True

	def kill(self, comment=None):
		self.comment = str(self)
		if comment: self.comment += " (%s)" % comment
		self.op = "nop"
		self.arg = ()
		self.flag = set()

